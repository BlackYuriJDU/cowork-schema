{
  "$schema": "./cowork-mode.schema.json",
  "mode": {
    "id": "cowork",
    "label": "Cowork",
    "icon": "monitor",
    "activateCommand": "cowork",
    "deactivateCommand": "chat"
  },
  "law": {
    "path": "./law/cowork-core.md",
    "header": "COWORK MODE ACTIVE — context injection (this is NOT a user message). Applies to ALL turns of this session; only /chat deactivates it."
  },
  "deliverables": {
    "directoryTemplate": "$COWORK_DIR/<YYYY-MM-DD>-<slug>/"
  },
  "browser": {
    "provider": "browser-use-cloud",
    "apiKeyEnv": "BROWSER_USE_API_KEY",
    "screenshotUrlPattern": "https://cdn\\.browser-use\\.com/screenshots/[^\\s\"'\\\\)]+"
  },
  "panel": {
    "timer": true,
    "iterationPrefix": "[COWORK ITERATION]",
    "objectFit": "contain"
  }
}
